<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Badge" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Badge.Translucent" parent="Theme.Badge">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.Badge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/badge_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Badge</item>
    </style>
</resources>